[Unit]
Description=Numeral Lord PvP relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=numeral-lord
Group=numeral-lord
WorkingDirectory=/opt/numeral-lord-next
Environment=NODE_ENV=production
Environment=PORT=2567
Environment=HOST=127.0.0.1
Environment=PATH=/opt/numeral-lord-runtime/current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/numeral-lord-runtime/current/bin/pnpm --filter @numeral-lord/server start
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
